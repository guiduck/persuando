{
  "name": "persuando",
  "version": "0.1.0",
  "private": true,
  "description": "Persuando real-time contextual assistant MVP workspace.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-placeholder.mjs",
    "dev:api": "npm run build && set PERSUANDO_BOOTSTRAP_API=true&& node apps/api/dist/src/main.js",
    "dev:capture": "npm run --workspace @persuando/capture dev",
    "dev:response": "npm run --workspace @persuando/response dev",
    "dev:worker": "npm run build && set PERSUANDO_BOOTSTRAP_WORKER=true&& node apps/api/dist/src/worker.js",
    "start:api": "node scripts/start-api.mjs",
    "start:worker": "node scripts/start-worker.mjs",
    "start:response": "npm run --workspace @persuando/response start",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node --test apps/*/test/*.test.mjs packages/*/test/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/format-check.mjs",
    "capture:start:vps": "npm run --workspace @persuando/capture start:vps",
    "capture:pack:win": "npm run --workspace @persuando/capture pack:win",
    "capture:dist:win": "npm run --workspace @persuando/capture dist:win"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron-builder": "^26.15.3",
    "prisma": "^7.8.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bullmq": "^5.77.2"
  }
}

